# Python virtual environments
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc

# Local environment files
**/.env

# Logs and caches
**/*.log
**/*.db
**/*.sqlite
CA/original/.rasa/
CA/original/logs/
CA/improved/.rasa/
CA/improved/logs/
RL/logs/
debug_logs/

# Model artifacts
**/*.pt
**/*.pth
**/*.ckpt
CA/original/models/*.tar.gz
CA/improved/models/*.tar.gz

# Unity / Visual Studio generated files
VR_RCEA/VR/.vs/
VR_RCEA/VR/Library/
VR_RCEA/VR/Logs/
VR_RCEA/VR/obj/
VR_RCEA/VR/UserSettings/
VR_RCEA/VR/*.csproj
