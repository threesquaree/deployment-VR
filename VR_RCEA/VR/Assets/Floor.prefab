    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: Jasper | Jeronimus Becx, 1643
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Portret van Dom Miguel de Castro
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Dom Miguel de Castro maakt hier een krachtige, serieuze indruk. Hij
        behoorde tot de Congolese rijken. Dit portret werd gemaakt in opdracht van
        de Hollandse West-Indische Compagnie. De WIC en de Congolese machthebbers
        verkochten goud en ivoor, maar vooral ook mensen. Daarom denken we nu anders
        over Dom Miguel. Dom draagt chique Europese kleding. Waarschijnlijk heeft
        hij deze kleding gekregen in Brazili\xEB, waar hij op bezoek was bij de Hollandse
        kolonie. "
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
