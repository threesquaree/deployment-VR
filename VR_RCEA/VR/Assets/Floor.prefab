  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Zwarte mensen waren in de 17de eeuw aanwezig in de Nederlandse samenleving
    \xE9n in de kunst.  \r\n\r\nRembrandt tekende en schilderde zwarte mensen. En
    ook sommige van zijn collega\u2019s deden dat. Maar hoe werden zwarte mensen
    in de 17de eeuw geschilderd in de Nederlandse kunst? En wie stonden er eigenlijk
    model?\r\n\r\nVooral tussen 1620 en 1660 werden er zwarte mensen geschilderd.
    Vaak op een hele realistische manier; en in allerlei verschillende rollen. Sinds
    kort weten we dat juist in de buurt van Rembrandts huis een aantal zwarte mensen
    woonden. Deze bijzondere periode in de Nederlandse kunst en geschiedenis is het
    onderwerp van deze tentoonstelling.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
