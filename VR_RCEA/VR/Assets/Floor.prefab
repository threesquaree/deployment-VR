    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: Leendert van der Cooghen, ca. 1660-1665
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Hoofd van een jongen
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Schilderen zoals je het ziet \u2013 dat was belangrijk voor Rembrandt
        en zijn tijdgenoten. Deze manier van schilderen betekende dat zij veel oefenden
        om realistisch te kunnen schilderen. Ook van zwarte mensen en in verschillende
        materialen: in inkt, krijt, verf, klei of op de etsplaat. Deze observaties
        werden later vaak gebruikt voor andere kunstwerken."
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
