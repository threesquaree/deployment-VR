    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: "CIGDEM YUKSEL (fotografie), J\xD6RGEN TJON A FONG (concept), 2020"
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: 'Hollandse Meesters Her-Zien: Debora Nassy'
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Debora Nassy was een vrouw van kleur die in Amsterdam als bediende
        werkte. Toen zij op het punt stond naar Guyana te vertrekken, bezocht zij
        een notaris, zodat zij niet overzee tot slaaf gemaakt zou kunnen worden.
        De Joods-Portugese David Nassy verklaarde daarom dat Debora \u2013 \u2018een
        bruijn vrouwspersoon ofte mulata\u2019 \u2013 in zijn huis in vrijheid was
        geboren en opgevoed."
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
    m_RemovedComponents: []
