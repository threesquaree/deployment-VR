    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: Govert Flinck, ca. 1639-1640
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Jonge zwarte boogschutter
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: 'Rembrandts leerlingen schilderden ook realistisch. In dit schilderij
        van Govert Flinck uit 1640 heeft misschien een zwarte man model gestaan die
        in de buurt woonde. Flinck heeft de gezichtsuitdrukking en gebaren van die
        man goed bestudeerd, om daarna een fantasiefiguur te schilderen, dat hij
        op de markt kon verkopen.  '
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
