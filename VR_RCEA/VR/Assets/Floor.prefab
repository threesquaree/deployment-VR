      value: 0.0446
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: Rembrandt, 1661
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Twee Afrikaanse mannen
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Het lijkt logisch dat hier twee zwarte buurtgenoten van Rembrandt model
        zaten. Maar het schilderij is uit 1661. Rembrandt woonde toen aan de andere
        kant van Amsterdam, op de Rozengracht. Toch blijkt uit documenten dat hij
        op de Jodenbreestraat ook al een schilderij van twee zwarte mannen had gemaakt.
        Waren er meerdere schilderijen met dit onderwerp? Of heeft Rembrandt het
        eerste schilderij pas na een paar jaar klaar en gedateerd?  Zeldzaam is ook
        dat Rembrandt de nauwe band tussen de mannen in beeld bracht. Waren het vrienden?
        Of broers misschien? Het blijft speculatie, maar stel de modellen waren broers
        en stel ze kwamen uit de buurt, dan zouden het Bastiaan en Manuel Fernando
        kunnen zijn. Zij waren zeelieden, van het eiland S\xE3o Tom\xE9, begin twintig
        en woonden op het einde van de straat bij de Sint Antoniespoort. "
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 4412893bd123d4a43b24f987b2bfb032, type: 3}
