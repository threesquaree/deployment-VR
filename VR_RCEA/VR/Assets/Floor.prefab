    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: IRIS KENSMIL, 2019
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: 'The New Utopia Begins Here: Hermina Huiswoud'
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Kensmil vestigt met haar portretten de aandacht op zwarte mensen die
        een belangrijke rol speelden in de geschiedenis. Hermina Huiswoud (1905 \u2013
        1998) was een politieke activiste. Ze behoorde tot een generatie antikoloniale
        denkers, leiders en organisatoren die actief waren in de strijd tegen Europees
        en Amerikaans imperialisme. Na de Tweede Wereldoorlog werkte zij in Amsterdam
        en streed zij vanuit de Vereniging Ons Suriname (VOS) voor de onafhankelijkheid
        van Suriname. "
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
    m_RemovedComponents: []
