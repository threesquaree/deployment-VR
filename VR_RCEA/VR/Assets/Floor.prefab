  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In de moderne kunst heeft zwart een heel andere rol dan in Rembrandts
    tijd. In 17de-eeuwse kunstwerken zien we zwarte mensen door de ogen van witte
    kunstenaars en weten we niet wie de modellen zijn. Nu zijn er zwarte kunstenaars
    die reflecteren op hun eigen identiteit, realiteit en omgeving. En als er nu
    zwarte mensen zijn afgebeeld, weten we wie het zijn. Nu is er inbreng van beide
    kanten, van kunstenaar en model. Nog sterker dan vroeger, geldt dat zwarte mensen
    aanwezig zijn, hier, in de maatschappij \xE9n in de kunst."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
