  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dom Miguel de Castro maakt hier een krachtige, serieuze indruk. Hij behoorde
    tot de Congolese rijken. Dit portret werd gemaakt in opdracht van de Hollandse
    West-Indische Compagnie. De WIC en de Congolese machthebbers verkochten goud
    en ivoor, maar vooral ook mensen. Daarom denken we nu anders over Dom Miguel.\r\nDom
    draagt chique Europese kleding. Waarschijnlijk heeft hij deze kleding gekregen
    in Brazili\xEB, waar hij op bezoek was bij de Hollandse kolonie.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
