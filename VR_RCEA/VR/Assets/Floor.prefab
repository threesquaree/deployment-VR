    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: Wenzel Hollar, 1645
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Portret van een meisje
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: Drie zeldzame etsen van zwarte mensen. Zij dragen gewone 17de-eeuwse
        kleding. Hollar maakte deze portretten in Antwerpen. De etsen waren om te
        verkopen. Etsen van mensen met een zwarte huid waren moeilijk te maken. Zo
        toonde de kunstenaar zijn vaardigheid . Dat viel in de smaak bij verzamelaars.
      objectReference: {fileID: 0}
