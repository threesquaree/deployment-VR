    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: Hendrick Heerschop, 1645
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Koning Caspar
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: Een van de drie koningen die het Christuskind komen aanbidden, zou volgens
        de legende een Afrikaan zijn. Soms wordt hij Caspar genoemd, soms Balthasar.
        Heerschop schilderde hem, zonder omgeving en verhaal. Hij is alleen te herkennen
        aan zijn kostbare kleding en de pot met de wierook die hij schonk. Maar de
        meeste aandacht trekt het gezicht van de man, die ons trots en zelfverzekerd
        aankijkt.
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
    m_RemovedComponents: []
