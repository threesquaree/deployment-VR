  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ilona, 2019\r\n\nHEDY TJIN\r\n\nHedy Tjin is illustratief vormgever. In
    haar werk komt haar fascinatie voor patronen en designs tot uiting, maar ook
    de invloed van culturele en etnische onderwerpen.\r\n\r\nHaar liefde voor werken
    met viltstift wordt gedreven door de vrijheid om overal en elk moment te kunnen
    tekenen. Dat is voor haar vaak therapeutisch.\r\n\r\nDierbaren en momentopnamen
    legt zij vast. Helaas is haar tante Ilona pas laat in haar leven gekomen en te
    vroeg overleden.\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
