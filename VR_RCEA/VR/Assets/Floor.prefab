      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Vanaf 1640 werden zwarte bedienden anders geschilderd, ze kregen een
        andere rol. Ze hoorden nu vaak bij \xE9\xE9n witte hoofdfiguur, en ze waren
        actief. Ze hielden een paard vast, of een spiegel om te helpen als een witte
        vrouw zich aankleedde. Ze stonden niet meer vooraan, maar aan de zijkant
        of in de achtergrond. Ze waren kleiner dan de hoofdfiguur. Zo kon de schilder
        de hoofdfiguur belangrijker laten lijken."
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
