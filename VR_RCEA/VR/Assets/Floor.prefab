  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Nieuw onderzoek heeft veel duidelijk gemaakt over de zwarte bewoners van
    17de-eeuws Amsterdam. Tussen 1630 en 1660 leefde er een kleine zwarte groep in
    de buurt van Rembrandts huis. De mannen waren zeelui. De vrouwen werkten als
    bediende of verhuurden bedden. En soms verdienden ze wat bij als figurant op
    het toneel, of als model voor kunstenaars. '
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
