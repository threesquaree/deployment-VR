      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: "IRI\xC9E ZAMBL\xC9, 2019"
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Doritos
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Een vrouw die met een zak zoutjes op de bank zit. Ook in alledaagse
        situaties zijn zwarte mensen nu in de kunst aanwezig. De kunstenares Iri\xE9e
        Zambl\xE9 zegt er zelf over: \u2018De mensen die mij dagelijks passeren,
        zie ik nog niet genoeg in de beeldende kunst terug. Daarom voel ik een drang
        om hen vast te leggen in mijn schilderijen.\u2019"
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
