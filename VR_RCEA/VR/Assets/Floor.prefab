  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Doritos, 2019\r\n\r\nIRI\xC9E ZAMBL\xC9\r\n\r\nEen vrouw die met een zak
    zoutjes op de bank zit. Ook in alledaagse situaties zijn zwarte mensen nu in
    de kunst aanwezig. De kunstenares Iri\xE9e Zambl\xE9 zegt er zelf over: \u2018De
    mensen die mij dagelijks passeren, zie ik nog niet genoeg in de beeldende kunst
    terug. Daarom voel ik een drang om hen vast te leggen in mijn schilderijen.\u2019"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
