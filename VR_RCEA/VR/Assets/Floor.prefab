    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: Jacob van der Ulft, 1653
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: De markt op de Dam
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: 'Nieuw onderzoek heeft veel duidelijk gemaakt over de zwarte bewoners
        van 17de-eeuws Amsterdam. Tussen 1630 en 1660 leefde er een kleine zwarte
        groep in de buurt van Rembrandts huis. De mannen waren zeelui. De vrouwen
        werkten als bediende of verhuurden bedden. En soms verdienden ze wat bij
        als figurant op het toneel, of als model voor kunstenaars. '
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
