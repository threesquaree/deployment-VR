      propertyPath: info
      value: DION ROSINA, 2019
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: The Unspoken Truth
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Voor dit schilderij gebruikte Dion Rosina een 19de-eeuwse foto van
        een tot slaafgemaakte man in Brazili\xEB. De opening verwijst naar het koloniale
        verleden van Nederland in Brazili\xEB. Een onderwerp dat een gat is in ons
        collectieve geheugen. Het verleden is achter de opening, maar dringt zich
        op via de man aan de kijker."
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
