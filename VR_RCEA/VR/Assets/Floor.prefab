    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: 'in: Johannes Blaeu, ''Grooten Atlas oft, Werelt-beschrijving'', Amsterdam
        1665. Salomon Savery naar Georg Marcgraf (kaart) en Frans Post (vignette)'
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Kaart van Pernambuco
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: "Hoe keken Hollanders aan tegen zwarte mensen in Afrika? En tegen de
        slaafgemaakten in Brazili\xEB? Daar was tussen 1630 en 1654 een Hollandse
        kolonie, waar veel suiker werd geproduceerd. Om winst te maken, werden slaafgemaakten
        uit Afrika gehaald. Schilderijen, tekeningen en kaarten gaven een te mooi
        beeld. Zo hielpen ze bij het goedkeuren van slavernij."
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 4412893bd123d4a43b24f987b2bfb032, type: 3}
