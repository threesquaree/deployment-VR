    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: info
      value: HEDY TIJN, 2019
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: title
      value: Ilona
      objectReference: {fileID: 0}
    - target: {fileID: 7360313227854661026, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: description
      value: 'Hedy Tjin is illustratief vormgever. In haar werk komt haar fascinatie
        voor patronen en designs tot uiting, maar ook de invloed van culturele en
        etnische onderwerpen.  Haar liefde voor werken met viltstift wordt gedreven
        door de vrijheid om overal en elk moment te kunnen tekenen. Dat is voor haar
        vaak therapeutisch.  Dierbaren en momentopnamen legt zij vast. Helaas is
        haar tante Ilona pas laat in haar leven gekomen en te vroeg overleden. '
      objectReference: {fileID: 0}
    - target: {fileID: 8944826696024470253, guid: 4412893bd123d4a43b24f987b2bfb032,
        type: 3}
      propertyPath: m_Layer
      value: 1
      objectReference: {fileID: 0}
