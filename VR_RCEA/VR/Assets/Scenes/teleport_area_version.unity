  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Dom Miguel de Castro makes here a powerful, serious expression. He was
    a member of the Congolese elite. This portrait was commissioned by the Dutch
    West India Company. The WIC and the Congolese rulers traded in gold an ivory,
    but mainly in people. This is why Dom Miguel now is seen as a controversial figure.

    Dom
    Miguel wears fashionable European clothes. This is probably the suit he had acquired
    in Brazil, when he had visited the Dutch colony earlier.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
