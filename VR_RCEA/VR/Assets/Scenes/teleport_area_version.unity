  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "It seems logical that two black neighbours of Rembrandt were \r        
    the models for this painting. But the painting is dated 1661, \r         when
    Rembrandt was living on Rozengracht, on the other side \r              of Amsterdam.
    However, there is documentary evidence that \r                       he had already
    made a painting of two black men while living \r                         in Jodenbreestraat.
    Were there other paintings of this subject? \r                                          
    Or did Rembrandt only finish off the first painting and date it \r                                            
    a few years later?\r\n\r\nIt is also unusual that Rembrandt depicted the close
    bond \r\nbetween the two men. Were they friends? Or perhaps brothers? \r            
    It remains speculation, but if the models were brothers, and if \r                         
    they came from the neighbourhood, they may have been Bastiaan \r                                          
    and Manuel Fernando. They were sailors from the island of S\xE3o \r                                              
    Tom\xE9 in their early twenties, who lived at the end of the street \r                                                     
    near Sint Antoniespoort.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
