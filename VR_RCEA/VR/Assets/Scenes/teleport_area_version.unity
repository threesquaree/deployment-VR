  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'A map of the Dutch colony in the northeast of Brazil. This is how the
    colony was depicted. Upper right there is a sugar mill where enslaved Africans
    worked. There is no hint of the harsh working conditions. To the left the Africans
    are shown dancing and making music. For the people of the Netherlands the gruesome
    reality of slavery was kept out of the picture. '
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
