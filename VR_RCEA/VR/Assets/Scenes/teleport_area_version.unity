  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: This finely executed study must have been observed directly. The boy looks
    very lifelike. Unfortunately, we know nothing about him. Leendert van der Cooghen
    lived and worked in Haarlem. He made this kind of study to find out how he could
    depict the subject best. It was study material, not intended for sale.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
