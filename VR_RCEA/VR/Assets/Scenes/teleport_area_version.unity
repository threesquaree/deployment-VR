  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Black plays an entirely different role in contemporary art than it did
    in Rembrandt\u2019s time. In seventeenth-century art we see black people through
    the eyes of white artists and we do not know who the models are. Black artists
    today often reflect on their own identity, reality, and surroundings. When black
    people are portrayed, we know who they are. There is agency from both sides now:
    of the maker and the sitter. Even more prominently than in the past, black people
    are present, here, in society and in art. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
