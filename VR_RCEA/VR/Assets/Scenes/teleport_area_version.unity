  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Dou was Rembrandt\u2019s first pupil. He took up his master\u2019s idea
    of studying black people. The result was this endearing tronie of a young  man
    in a fantasy costume, who looks at us over his shoulder.  "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
