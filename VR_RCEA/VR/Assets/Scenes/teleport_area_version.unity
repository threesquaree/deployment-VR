      m_Calls: []
  m_text: "Doritos, 2019\r\n\r\nIRI\xC9E ZAMBL\xC9\r\n\r\nA woman sits on a couch
    holding a bag of tortilla chips. Black people are now represented in art in everyday
    situations. The artist Iri\xE9e Zambl\xE9 expresses her feelings: \u2018I still
    don't see enough of the people who pass me every day reflected in art. That's
    why I feel an urge to capture them in my paintings.\u2019 "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
