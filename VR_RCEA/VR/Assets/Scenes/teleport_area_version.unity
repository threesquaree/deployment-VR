  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Lievens made this drawing in Leiden when he was working closely with his
    friend Rembrandt. The individual appearance makes  it clear that someone modelled
    for this, but that model was then given a turban and a feather to wear, turning
    him into a Mediterranean type. '
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
